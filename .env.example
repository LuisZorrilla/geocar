# Conexión a PostgreSQL (requerida)
DATABASE_URL="postgres://postgres:TU_CLAVE@localhost:5432/geocar"

# Desarrollo: si la base está vacía, siembra las 3 empresas demo e imprime
# sus credenciales en la consola del servidor. NUNCA activar en producción.
SEED_DEMO_DATA=true

# Producción: si la base está vacía y SEED_DEMO_DATA no es true, se crea solo
# este superadmin. La contraseña debe tener al menos 10 caracteres, con letras y números.
SUPERADMIN_USERNAME=""
SUPERADMIN_PASSWORD=""

# Sesiones
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7

# Servidor
PORT=3000
# Si corre detrás de un balanceador o proxy inverso (para que el rate limit vea la IP real), p. ej. 1
TRUST_PROXY=""

# Conexión de las cámaras (lo que se programa en cada equipo; ver docs/TRACCAR.md)
# Dominio o IP pública del VPS donde corre Traccar
DEVICE_SERVER_HOST=""
DEVICE_JT808_PORT=5015
DEVICE_JT1078_PORT=5263
# Puerto Teltonika en Traccar para los OBD-II (FMC003). Abrir 5027/TCP en el firewall del VPS.
DEVICE_TELTONIKA_PORT=5027
# Puerto OsmAnd en Traccar para los celulares de los choferes (Traccar Client). Abrir 5055/TCP en el firewall del VPS.
DEVICE_OSMAND_PORT=5055

# Ingesta Traccar → panel. Secreto compartido; Traccar lo envía como "Authorization: Bearer <token>".
# Vacío = ingesta deshabilitada. Generar con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INGEST_TOKEN=""

# false en producción: apaga el movimiento simulado de las unidades demo
SIMULATED_TELEMETRY=true

# true para registrar en consola cada posición recibida de Traccar (útil en el piloto)
INGEST_LOG=false

# Traccar local o del VPS (lo usa npm run traccar:check)
TRACCAR_WEB_URL="http://localhost:8082"
TRACCAR_ADMIN_EMAIL=""
TRACCAR_ADMIN_PASSWORD=""
